<Window x:Class="Zevision.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Zevision.ViewModels.Main"
        xmlns:display="clr-namespace:Zevision.ViewModels.Display"
        xmlns:t="clr-namespace:Zevision.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding Title}"
        Icon="/Assets/Zevision.ico"
        Width="1200" Height="820" MinWidth="960" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontSize="13">

    <Window.Resources>
        <!-- 左侧顶部标题栏与右侧"数据显示"标题行的共同高度,保证两侧对齐 -->
        <sys:Double x:Key="PanelHeaderHeight">48</sys:Double>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <!-- 左侧配置项的统一间距 -->
        <Style x:Key="ConfigComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- 数据显示区单条记录 -->
        <DataTemplate x:Key="LogEntryTemplate" DataType="{x:Type display:LogEntry}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TimeText" Grid.Column="0"
                           Text="{Binding Timestamp, StringFormat=HH:mm:ss.fff}"
                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                           Margin="0,0,10,0" />
                <Border x:Name="KindBadge" Grid.Column="1"
                        CornerRadius="3" Padding="6,0" Margin="0,0,10,0" MinWidth="44"
                        Background="{DynamicResource MaterialDesign.Brush.Separator.Background}">
                    <TextBlock x:Name="KindText" Text="INFO" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </Border>
                <TextBlock x:Name="EntryText" Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static display:LogKind.Tx}">
                    <Setter TargetName="KindText" Property="Text" Value="TX" />
                    <Setter TargetName="KindBadge" Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                    <Setter TargetName="KindText" Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static display:LogKind.Rx}">
                    <Setter TargetName="KindText" Property="Text" Value="RX" />
                    <Setter TargetName="KindBadge" Property="Background" Value="{DynamicResource MaterialDesign.Brush.Secondary}" />
                    <Setter TargetName="KindText" Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Secondary.Foreground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static display:LogKind.Error}">
                    <Setter TargetName="KindText" Property="Text" Value="ERR" />
                    <Setter TargetName="KindBadge" Property="Background" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                    <Setter TargetName="KindText" Property="Foreground" Value="White" />
                    <Setter TargetName="EntryText" Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                </DataTrigger>
                <!-- 多行响应的后续行:保留列宽对齐,隐藏时间和类型 -->
                <DataTrigger Binding="{Binding IsContinuation}" Value="True">
                    <Setter TargetName="TimeText" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="KindBadge" Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsContinuation}" Value="True" />
                        <Condition Binding="{Binding Kind}" Value="{x:Static display:LogKind.Info}" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="EntryText" Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧:通讯配置与连接控制 ============ -->
        <materialDesign:Card Grid.Column="0" Margin="12,12,6,12" UniformCornerRadius="8">
            <DockPanel>
                <!-- 高度与右侧"数据显示"标题行一致 (共用 PanelHeaderHeight) -->
                <materialDesign:ColorZone x:Name="LeftHeader" DockPanel.Dock="Top" Mode="PrimaryMid" Padding="16,0" CornerRadius="8,8,0,0"
                                          Height="{StaticResource PanelHeaderHeight}" VerticalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="SerialPort" Width="22" Height="22" VerticalAlignment="Center" />
                        <TextBlock Text="Zevision" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static t:UiText.HeaderSubtitle}" Opacity="0.8" Margin="10,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </materialDesign:ColorZone>

                <!-- 底部:连接/断开与状态 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
                    <UniformGrid Columns="2">
                        <Button Command="{Binding ConnectCommand}" Margin="0,0,6,0" Padding="8,4"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LanConnect" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static t:UiText.Connect}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DisconnectCommand}" Margin="6,0,0,0" Padding="8,4"
                                Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LanDisconnect" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static t:UiText.Disconnect}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <DockPanel Margin="2,12,0,0">
                        <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource MaterialDesign.Brush.Secondary}" />
                                        </DataTrigger>
                                        <!-- 正在连接、握手或等待自动重连 -->
                                        <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <!-- 重连提示较长:放不下时截断,完整内容见提示 -->
                        <TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>

                <Separator DockPanel.Dock="Bottom" Margin="0" />

                <!-- 仪器配置:连接后可用;保存/恢复期间显示进度和取消 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,8">
                    <TextBlock Text="{x:Static t:UiText.InstrumentConfig}" FontWeight="SemiBold" Margin="0,0,0,8"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                    <!-- 三个按钮并排:内边距较小,英文 "Restore"、"Process" 也能放下 -->
                    <UniformGrid Columns="3">
                        <Button Command="{Binding Config.SaveCommand}" Margin="0,0,3,0" Padding="3,4"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="{x:Static t:UiText.SaveConfigToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static t:UiText.Save}" Margin="3,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding Config.RestoreCommand}" Margin="1,0,1,0" Padding="3,4"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="{x:Static t:UiText.RestoreConfigToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Upload" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static t:UiText.Restore}" Margin="3,0,0,0" />
                            </StackPanel>
                        </Button>
                        <!-- 工艺编辑:编辑材料和工艺,保存时上传到设备 -->
                        <Button Command="{Binding Config.DesignCommand}" Margin="3,0,0,0" Padding="3,4"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="{x:Static t:UiText.DesignToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatListNumbered" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static t:UiText.Design}" Margin="3,0,0,0" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- 修改:先选数据来源 (实机数据 / 保存的配置) -->
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Command="{Binding Config.EditCommand}" Margin="8,0,0,0" Padding="6,4"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="{x:Static t:UiText.EditConfigToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pencil" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static t:UiText.Edit}" Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                        <ComboBox ItemsSource="{Binding Config.EditSources}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Config.EditSource}"
                                  VerticalAlignment="Center"
                                  ToolTip="{x:Static t:UiText.EditSourceToolTip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" ToolTip="{Binding Description}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding Config.IsBusy, Converter={StaticResource BooleanToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{x:Static t:UiText.Cancel}" Padding="8,0" Height="24"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding Config.CancelCommand}" />
                            <TextBlock Text="{Binding Config.Operation.Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ProgressBar Margin="0,4,0,0" Height="4"
                                     Value="{Binding Config.Operation.Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding Config.Operation.IsIndeterminate}" />
                    </StackPanel>
                </StackPanel>

                <Separator DockPanel.Dock="Bottom" Margin="0" />

                <!-- 中部:配置项,连接期间锁定 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsDisconnected}">
                    <StackPanel Margin="16,16,16,8">
                        <TextBlock Text="{x:Static t:UiText.ConnectionSettings}" FontWeight="SemiBold" Margin="0,0,0,12"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />

                        <!-- 连接方式:选中的 tab 决定连接时创建串口还是 TCP 连接 -->
                        <TabControl SelectedIndex="{Binding Connection.ConnectionTabIndex}"
                                    materialDesign:ColorZoneAssist.Mode="Standard">
                            <TabItem Header="RS232" ToolTip="{x:Static t:UiText.SerialTabToolTip}" ToolTipService.ShowOnDisabled="True" />
                            <TabItem Header="TCP" ToolTip="{x:Static t:UiText.TcpTabToolTip}"
                                     ToolTipService.ShowOnDisabled="True" />
                        </TabControl>

                        <!-- 两种设置叠放在同一格中,未选中的用 Hidden (仍占位):区域高度固定为较高的一种,
                             切换 tab 时下方"协议选项"等位置不变 -->
                        <Grid Margin="0,12,0,8">
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Connection.IsSerialConnection}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Style="{StaticResource ConfigComboBox}"
                                              materialDesign:HintAssist.Hint="{x:Static t:UiText.Port}"
                                              ItemsSource="{Binding Connection.AvailablePorts}"
                                              SelectedItem="{Binding Connection.SelectedPort}"
                                              ToolTip="{x:Static t:UiText.PortToolTip}"
                                              ToolTipService.ShowOnDisabled="True" />
                                    <Button Grid.Column="1" Margin="4,0,0,12" VerticalAlignment="Center"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding RefreshPortsCommand}"
                                            ToolTip="{x:Static t:UiText.RescanPorts}">
                                        <materialDesign:PackIcon Kind="Refresh" />
                                    </Button>
                                </Grid>

                                <ComboBox Style="{StaticResource ConfigComboBox}" Margin="0"
                                          materialDesign:HintAssist.Hint="{x:Static t:UiText.BaudRate}"
                                          ItemsSource="{Binding Connection.BaudRates}"
                                          SelectedItem="{Binding Connection.SelectedBaudRate}"
                                          ToolTip="{x:Static t:UiText.BaudRateToolTip}"
                                          ToolTipService.ShowOnDisabled="True" />
                            </StackPanel>

                            <TextBox VerticalAlignment="Top"
                                     materialDesign:HintAssist.Hint="{x:Static t:UiText.IpAddress}"
                                     Text="{Binding Connection.TcpHost, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{x:Static t:UiText.IpAddressToolTip}"
                                     ToolTipService.ShowOnDisabled="True">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Connection.IsTcpConnection}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>

                        <TextBlock Text="{x:Static t:UiText.ProtocolOptions}" FontWeight="SemiBold" Margin="0,0,0,12"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                   ToolTip="{x:Static t:UiText.ProtocolOptionsToolTip}"
                                   ToolTipService.ShowOnDisabled="True" />

                        <ComboBox Style="{StaticResource ConfigComboBox}"
                                  materialDesign:HintAssist.Hint="{x:Static t:UiText.ResponseTimeout}"
                                  ItemsSource="{Binding Connection.TimeoutOptions}"
                                  SelectedItem="{Binding Connection.SelectedTimeout}"
                                  ToolTip="{x:Static t:UiText.ResponseTimeoutToolTip}"
                                  ToolTipService.ShowOnDisabled="True" />

                        <DockPanel Margin="0,2" Background="Transparent"
                                   ToolTip="{x:Static t:UiText.ChecksumToolTip}"
                                   ToolTipService.ShowOnDisabled="True">
                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding Connection.IsChecksumEnabled}"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            <TextBlock Text="{Binding Connection.ChecksumLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,2" Background="Transparent"
                                   ToolTip="{x:Static t:UiText.LengthToolTip}"
                                   ToolTipService.ShowOnDisabled="True">
                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding Connection.IsLengthEnabled}"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            <TextBlock Text="{Binding Connection.LengthLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,2" Background="Transparent"
                                   ToolTip="{x:Static t:UiText.HandshakeToolTip}"
                                   ToolTipService.ShowOnDisabled="True">
                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding Connection.IsHandshakeEnabled}"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            <TextBlock Text="{x:Static t:UiText.Handshake}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,2" Background="Transparent"
                                   ToolTip="{x:Static t:UiText.AutoReconnectToolTip}"
                                   ToolTipService.ShowOnDisabled="True">
                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding Connection.IsAutoReconnectEnabled}"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            <TextBlock Text="{x:Static t:UiText.AutoReconnect}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,2" Background="Transparent"
                                   ToolTip="{x:Static t:UiText.SaveCommunicationDataToolTip}"
                                   ToolTipService.ShowOnDisabled="True">
                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding Connection.IsSaveCommunicationDataEnabled}"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            <TextBlock Text="{x:Static t:UiText.SaveCommunicationData}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </materialDesign:Card>

        <!-- ============ 右侧:数据显示与指令输入 ============ -->
        <Grid Grid.Column="1" Margin="6,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 数据显示 -->
            <materialDesign:Card Grid.Row="0" UniformCornerRadius="8">
                <DockPanel>
                    <!-- 高度与左侧顶部标题栏一致 (共用 PanelHeaderHeight) -->
                    <DockPanel x:Name="LogHeader" DockPanel.Dock="Top" Margin="16,0,8,0" Height="{StaticResource PanelHeaderHeight}">
                        <!-- 切换中英文 (确认后保存配置并重启程序) -->
                        <Button DockPanel.Dock="Right" Command="{Binding SwitchLanguageCommand}" VerticalAlignment="Center"
                                Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{Binding SwitchLanguageToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Translate" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SwitchLanguageText}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding ClearLogCommand}" VerticalAlignment="Center"
                                Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static t:UiText.ClearLogToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteSweep" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static t:UiText.Clear}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="TX " Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                            <TextBlock Text="{Binding TxCount}" FontWeight="SemiBold" />
                            <TextBlock Text="   RX " Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                            <TextBlock Text="{Binding RxCount}" FontWeight="SemiBold" />
                            <!-- 错误指令数:有错误时用错误色显示 -->
                            <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{x:Static t:UiText.ErrorCountToolTip}">
                                <TextBlock Text="   ERR " Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                <TextBlock Text="{Binding ErrorCount}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ConsoleLine" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <TextBlock Text="{x:Static t:UiText.DataDisplay}" FontWeight="SemiBold" FontSize="15" Margin="8,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Separator DockPanel.Dock="Top" Margin="0" />
                    <ListBox x:Name="LogList"
                             ItemsSource="{Binding Log.Entries}"
                             ScrollViewer.ScrollChanged="OnLogScrollChanged"
                             ItemTemplate="{StaticResource LogEntryTemplate}"
                             FontFamily="Consolas, Microsoft YaHei UI"
                             Padding="8"
                             SelectionMode="Extended"
                             ToolTip="{x:Static t:UiText.LogListToolTip}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="6,1" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.CommandBindings>
                            <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopyLog" />
                        </ListBox.CommandBindings>
                    </ListBox>
                </DockPanel>
            </materialDesign:Card>

            <!-- 指令输入 -->
            <materialDesign:Card Grid.Row="1" Margin="0,12,0,0" Padding="16,12" UniformCornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 发送选项 (连接期间也可修改):显示格式只影响之后的数据;勾选重复发送后,点击发送按间隔重复 -->
                    <!-- 底部对齐:重复间隔下拉框的底边与输入框底边对齐 (右侧输入框拉伸填满剩余高度) -->
                    <StackPanel Grid.Column="0" Width="160" Margin="0,0,16,0" VerticalAlignment="Bottom">
                        <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  materialDesign:HintAssist.Hint="{x:Static t:UiText.DisplayFormat}"
                                  ItemsSource="{Binding SendOptions.DisplayFormats}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SendOptions.DisplayFormat}"
                                  ToolTip="{x:Static t:UiText.DisplayFormatToolTip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" ToolTip="{Binding Description}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox Content="{x:Static t:UiText.RepeatSend}" Margin="0,8"
                                  IsChecked="{Binding SendOptions.IsRepeatEnabled}"
                                  ToolTip="{x:Static t:UiText.RepeatSendToolTip}" />
                        <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  materialDesign:HintAssist.Hint="{x:Static t:UiText.RepeatInterval}"
                                  ItemsSource="{Binding SendOptions.RepeatIntervals}"
                                  SelectedItem="{Binding SendOptions.RepeatInterval}"
                                  IsEnabled="{Binding SendOptions.IsRepeatEnabled}"
                                  ToolTip="{x:Static t:UiText.RepeatIntervalToolTip}"
                                  ToolTipService.ShowOnDisabled="True" />
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="{x:Static t:UiText.QuickCommands}" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                            <ItemsControl ItemsSource="{Binding Connection.QuickCommands}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Margin="0,0,8,4" Padding="12,0" Height="28"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Command="{Binding DataContext.SendQuickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 多行输入:Enter 发送,Shift+Enter 换行 (OnCommandInputKeyDown);每行一条指令 -->
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="{x:Static t:UiText.CommandInputHint}"
                                     FontFamily="Consolas, Microsoft YaHei UI"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="88" MaxHeight="160"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     PreviewKeyDown="OnCommandInputKeyDown"
                                     Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid Grid.Column="1" Margin="12,0,0,0" MinWidth="100">
                                <Button Style="{StaticResource MaterialDesignRaisedButton}" Height="Auto"
                                        Command="{Binding SendCommand}" IsDefault="False"
                                        Visibility="{Binding SendOptions.IsNotRepeating, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Send" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Static t:UiText.Send}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignRaisedSecondaryButton}" Height="Auto"
                                        Command="{Binding SendOptions.StopRepeatCommand}"
                                        ToolTip="{x:Static t:UiText.StopToolTip}"
                                        Visibility="{Binding SendOptions.IsRepeating, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Stop" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Static t:UiText.Stop}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>
