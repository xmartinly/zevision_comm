<Window x:Class="Zevision.Views.ProcessDesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Zevision.ViewModels.Design"
        xmlns:t="clr-namespace:Zevision.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ProcessDesignerViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding Title}"
        Icon="/Assets/Zevision.ico"
        Width="1200" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontSize="13">

    <!-- Ctrl+S 保存到本地;Esc 上传期间取消上传,否则关闭 (有未保存的修改时先确认) -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <!--
            材料页按列对齐:输入框和下拉框都是一列宽 (Field、Choice:192 + 右边距 12),跨两列的为 396。
            预熔、后处理的标题也占一列,三个值对齐到第 2~4 列。
        -->
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Width" Value="192" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="WideField" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="Width" Value="260" />
        </Style>
        <Style x:Key="SmallField" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="Width" Value="150" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="Choice" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Width" Value="192" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="Width" Value="192" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <!-- 本地材料、工艺列表的一项:名称,下面一行是设备上是否已有同名的对象 -->
        <DataTemplate x:Key="LocalItemTemplate">
            <StackPanel>
                <TextBlock Text="{Binding DisplayName}" />
                <TextBlock Text="{Binding DeviceStatus}" FontSize="11" Margin="0,1,0,0"
                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
            </StackPanel>
        </DataTemplate>

        <!-- "设备"页的一项:ID 和名称,下面是膜层或密度、膜系 -->
        <DataTemplate x:Key="DeviceObjectTemplate" DataType="{x:Type vm:DeviceObjectViewModel}">
            <StackPanel Margin="0,2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
            </StackPanel>
        </DataTemplate>

        <!-- 一段预熔或后处理:标题 (第 1 列)、三个值 (第 2~4 列)、删除 -->
        <DataTemplate x:Key="PreStepTemplate" DataType="{x:Type vm:ConditionStepViewModel}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignPreRampTime}"
                         Text="{Binding RampTime, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignPreRampPower}"
                         Text="{Binding RampPower, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignPreHoldTime}"
                         Text="{Binding HoldTime, UpdateSourceTrigger=PropertyChanged}" />
                <Button Style="{StaticResource IconButton}" Command="{Binding RemoveCommand}" ToolTip="{x:Static t:UiText.DesignRemove}"
                        Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}">
                    <materialDesign:PackIcon Kind="Close" />
                </Button>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PostStepTemplate" DataType="{x:Type vm:ConditionStepViewModel}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignPostRampTime}"
                         Text="{Binding RampTime, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignPostRampPower}"
                         Text="{Binding RampPower, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignPostHoldTime}"
                         Text="{Binding HoldTime, UpdateSourceTrigger=PropertyChanged}" />
                <Button Style="{StaticResource IconButton}" Command="{Binding RemoveCommand}" ToolTip="{x:Static t:UiText.DesignRemove}"
                        Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}">
                    <materialDesign:PackIcon Kind="Close" />
                </Button>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- 底部:保存位置、结果、进度、按钮 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Margin="0,0,8,0" Command="{Binding CancelCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                            <Setter Property="Content" Value="{x:Static t:UiText.Close}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Content" Value="{x:Static t:UiText.DesignCancelUpload}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="0,0,8,0" Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        ToolTip="{x:Static t:UiText.DesignSaveToolTip}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static t:UiText.Save}" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <!-- 上传选中的工艺 (先保存):按钮上显示工艺名称 -->
                <Button Command="{Binding UploadCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                        ToolTip="{x:Static t:UiText.DesignUploadToolTip}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Upload" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static t:UiText.DesignUpload}" Margin="6,0,0,0" />
                        <TextBlock Text="{Binding SelectedProcess.DisplayName}" Margin="4,0,0,0" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="{Binding PathText}" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" TextTrimming="CharacterEllipsis" />
                <!-- 上一次操作的结果 (代替提示框);设备和文件都没有改变的问题为红字,改变了设备或文件的失败另外弹出错误框 -->
                <ScrollViewer MaxHeight="120" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasResultText, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ScrollViewer>
                <StackPanel Margin="0,6,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="{Binding Operation.Text}" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                    <ProgressBar Height="4" Margin="0,4,0,0"
                                 Value="{Binding Operation.Progress, Mode=OneWay}"
                                 IsIndeterminate="{Binding Operation.IsIndeterminate}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <!-- 材料:每种材料在设备上是一个材料和一个膜系 -->
            <TabItem Header="{x:Static t:UiText.DesignMaterialsTab}">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:Card Grid.Column="0" UniformCornerRadius="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
                                <Button Command="{Binding AddMaterialCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Static t:UiText.DesignNew}" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DeleteMaterialCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="8,0"
                                        Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Static t:UiText.DesignDelete}" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}" ItemTemplate="{StaticResource LocalItemTemplate}"
                                     IsEnabled="{Binding IsEditable}" Margin="0,0,0,8" />
                        </DockPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="2" UniformCornerRadius="8">
                        <Grid>
                            <TextBlock Text="{x:Static t:UiText.DesignNoSelection}" Margin="16" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasSelectedMaterial, Converter={StaticResource BooleanToVisibility}}"
                                          Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                <StackPanel Margin="16,12,16,4" DataContext="{Binding SelectedMaterial}" IsEnabled="{Binding IsEditable}">
                                    <TextBlock Text="{x:Static t:UiText.DesignMaterialSection}" Style="{StaticResource SectionTitle}" />
                                    <WrapPanel>
                                        <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignName}"
                                                 ToolTip="{x:Static t:UiText.DesignNameToolTip}" MaxLength="30"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <!-- 材料库:输入关键字 (化学式、英文名、中文名) 筛选,选择后填入名称、密度、Z 比;展开时不全选 (见代码隐藏) -->
                                        <ComboBox Style="{StaticResource Choice}" Width="396" IsEditable="True" IsTextSearchEnabled="False"
                                                  DropDownOpened="OnLibraryDropDownOpened"
                                                  materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignLibrary}"
                                                  ToolTip="{x:Static t:UiText.DesignLibraryToolTip}"
                                                  ItemsSource="{Binding LibraryMatches}" DisplayMemberPath="Text"
                                                  Text="{Binding LibrarySearch, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedItem="{Binding LibraryPick}"
                                                  IsDropDownOpen="{Binding IsLibraryOpen}"
                                                  IsEnabled="{Binding DataContext.HasLibrary, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                    <Setter Property="ToolTip" Value="{Binding Description}" />
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignDensity}"
                                                 Text="{Binding Density, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignZRatio}"
                                                 Text="{Binding ZRatio, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignTooling}"
                                                 Text="{Binding Tooling, UpdateSourceTrigger=PropertyChanged}" />
                                    </WrapPanel>

                                    <TextBlock Text="{x:Static t:UiText.DesignSensorSection}" Style="{StaticResource SectionTitle}" />
                                    <WrapPanel>
                                        <ComboBox Style="{StaticResource Choice}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignSensor}"
                                                  ItemsSource="{Binding SensorChoices}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Sensor}" />
                                        <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignCrystalPosition}"
                                                 Text="{Binding CrystalPosition, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox Style="{StaticResource Choice}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignSource}"
                                                  ItemsSource="{Binding SourceChoices}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Source}" />
                                        <ComboBox Style="{StaticResource Choice}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignCrucible}"
                                                  ItemsSource="{Binding CrucibleChoices}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Crucible}" />
                                    </WrapPanel>

                                    <TextBlock Text="{x:Static t:UiText.DesignControlSection}" Style="{StaticResource SectionTitle}" />
                                    <WrapPanel>
                                        <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignPTerm}"
                                                 Text="{Binding PTerm, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignITerm}"
                                                 Text="{Binding ITerm, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignDTerm}"
                                                 Text="{Binding DTerm, UpdateSourceTrigger=PropertyChanged}" />
                                    </WrapPanel>
                                    <WrapPanel>
                                        <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignMaxPower}"
                                                 Text="{Binding MaxPower, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox Style="{StaticResource Choice}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignMaxPowerOption}"
                                                  ItemsSource="{Binding MaxPowerOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding MaxPowerOption}" />
                                        <ComboBox Style="{StaticResource Choice}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignDelayOption}"
                                                  ItemsSource="{Binding DelayOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding DelayOption}" />
                                    </WrapPanel>

                                    <!-- 延迟设置:延迟选项不为 0 时显示 (为 0 时不写入设备) -->
                                    <StackPanel Visibility="{Binding HasDelaySettings, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Text="{x:Static t:UiText.DesignDelaySection}" Style="{StaticResource SectionTitle}" />
                                        <WrapPanel>
                                            <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignControlDelayTime}"
                                                     Text="{Binding ControlDelayTime, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignShutterDelayAccuracy}"
                                                     Text="{Binding ShutterDelayAccuracy, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignShutterDelayTimeout}"
                                                     Text="{Binding ShutterDelayTimeout, UpdateSourceTrigger=PropertyChanged}" />
                                        </WrapPanel>
                                        <WrapPanel>
                                            <ComboBox Style="{StaticResource Choice}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignTransferSensor}"
                                                      ItemsSource="{Binding TransferSensorChoices}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                                      SelectedValue="{Binding TransferSensor}" />
                                            <TextBox Style="{StaticResource Field}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignTransferTooling}"
                                                     Text="{Binding TransferTooling, UpdateSourceTrigger=PropertyChanged}" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <TextBlock Text="{x:Static t:UiText.DesignPreConditions}" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding PreConditions}" ItemTemplate="{StaticResource PreStepTemplate}" Focusable="False" />
                                    <Button Style="{StaticResource AddButton}" Command="{Binding AddPreConditionCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Static t:UiText.DesignAddPreCondition}" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="{x:Static t:UiText.DesignPostConditions}" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding PostConditions}" ItemTemplate="{StaticResource PostStepTemplate}" Focusable="False" />
                                    <Button Style="{StaticResource AddButton}" Command="{Binding AddPostConditionCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Static t:UiText.DesignAddPostCondition}" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- 工艺:每一步在设备上是一个膜层,工艺的膜层列表按步骤顺序 -->
            <TabItem Header="{x:Static t:UiText.DesignProcessesTab}">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:Card Grid.Column="0" UniformCornerRadius="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
                                <Button Command="{Binding AddProcessCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Static t:UiText.DesignNew}" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DeleteProcessCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="8,0"
                                        Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Static t:UiText.DesignDelete}" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" ItemTemplate="{StaticResource LocalItemTemplate}"
                                     IsEnabled="{Binding IsEditable}" Margin="0,0,0,8" />
                        </DockPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="2" UniformCornerRadius="8">
                        <Grid>
                            <TextBlock Text="{x:Static t:UiText.DesignNoSelection}" Margin="16" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasSelectedProcess, Converter={StaticResource BooleanToVisibility}}"
                                          Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                <StackPanel Margin="16,12,16,4" DataContext="{Binding SelectedProcess}" IsEnabled="{Binding IsEditable}">
                                    <WrapPanel>
                                        <!-- 设备的帮助表只显示名称的前 30 个字符 (DesignRules.MaxNameLength) -->
                                        <TextBox Style="{StaticResource WideField}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignName}"
                                                 ToolTip="{x:Static t:UiText.DesignProcessNameToolTip}" MaxLength="30"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <CheckBox Content="{x:Static t:UiText.DesignAutoStartNext}" IsChecked="{Binding AutoStartNext}"
                                                  VerticalAlignment="Center" Margin="0,0,12,12" />
                                    </WrapPanel>
                                    <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                               Visibility="{Binding HasLastUpload, Converter={StaticResource BooleanToVisibility}}">
                                        <Run Text="{x:Static t:UiText.DesignLastUpload}" /><Run Text="{Binding LastUpload, Mode=OneWay}" />
                                    </TextBlock>

                                    <TextBlock Text="{x:Static t:UiText.DesignSteps}" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ProcessStepViewModel}">
                                                <StackPanel>
                                                    <!-- 下边距留出输入框下方的错误提示 (如“最多 3 位小数”) -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <TextBlock Text="{Binding Number}" Width="28" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,12" />
                                                        <ComboBox Style="{StaticResource Choice}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignStepMaterial}"
                                                                  ItemsSource="{Binding Materials}" DisplayMemberPath="DisplayName"
                                                                  SelectedItem="{Binding Material}" />
                                                        <TextBox Style="{StaticResource Field}" Width="140" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignRate}"
                                                                 Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                                        <TextBox Style="{StaticResource Field}" Width="150" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignThickness}"
                                                                 Text="{Binding Thickness, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                                        <Button Style="{StaticResource IconButton}" Command="{Binding MoveUpCommand}" ToolTip="{x:Static t:UiText.DesignMoveUp}">
                                                            <materialDesign:PackIcon Kind="ArrowUp" />
                                                        </Button>
                                                        <Button Style="{StaticResource IconButton}" Command="{Binding MoveDownCommand}" ToolTip="{x:Static t:UiText.DesignMoveDown}">
                                                            <materialDesign:PackIcon Kind="ArrowDown" />
                                                        </Button>
                                                        <Button Style="{StaticResource IconButton}" Command="{Binding AddRampCommand}" ToolTip="{x:Static t:UiText.DesignAddRampToolTip}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                                                                <TextBlock Text="{x:Static t:UiText.DesignAddRamp}" Margin="2,0,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource IconButton}" Command="{Binding RemoveCommand}" ToolTip="{x:Static t:UiText.DesignRemove}"
                                                                Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}">
                                                            <materialDesign:PackIcon Kind="Close" />
                                                        </Button>
                                                    </StackPanel>
                                                    <!-- 速率斜坡:缩进在步骤下面 -->
                                                    <ItemsControl ItemsSource="{Binding RateRamps}" Margin="28,0,0,0" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:RateRampViewModel}">
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                                    <TextBlock Text="{Binding Title}" Width="100" VerticalAlignment="Center" Margin="0,0,8,8"
                                                                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                                                    <TextBox Style="{StaticResource SmallField}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignRampStart}"
                                                                             Text="{Binding StartThickness, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                                                    <TextBox Style="{StaticResource SmallField}" Width="190" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignRampDuration}"
                                                                             Text="{Binding RampTime, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                                                    <TextBox Style="{StaticResource SmallField}" materialDesign:HintAssist.Hint="{x:Static t:UiText.DesignNewRate}"
                                                                             Text="{Binding NewRate, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                                                    <Button Style="{StaticResource IconButton}" Command="{Binding RemoveCommand}" ToolTip="{x:Static t:UiText.DesignRemove}"
                                                                            Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}" Margin="0,8,0,0">
                                                                        <materialDesign:PackIcon Kind="Close" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource AddButton}" Command="{Binding AddStepCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Static t:UiText.DesignAddStep}" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- 设备:设备上的工艺和材料 (只读,可以刷新、删除;不改动本地的材料和工艺) -->
            <TabItem Header="{x:Static t:UiText.DesignDeviceTab}">
                <DockPanel Margin="0,8,0,0" DataContext="{Binding Device}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="10,0" Height="30" ToolTip="{x:Static t:UiText.DesignRefreshToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static t:UiText.DesignRefresh}" Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:Card Grid.Column="0" UniformCornerRadius="8">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="8">
                                    <Button DockPanel.Dock="Right" Command="{Binding DeleteProcessCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="8,0"
                                            Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}" ToolTip="{x:Static t:UiText.DesignDeleteDeviceProcessToolTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Static t:UiText.DesignDelete}" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding ProcessesTitle}" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <ListBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" ItemTemplate="{StaticResource DeviceObjectTemplate}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding IsEditable}" Margin="0,0,0,8" />
                            </DockPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Grid.Column="2" UniformCornerRadius="8">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="8">
                                    <Button DockPanel.Dock="Right" Command="{Binding DeleteMaterialCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="8,0"
                                            Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}" ToolTip="{x:Static t:UiText.DesignDeleteDeviceMaterialToolTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Static t:UiText.DesignDelete}" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding MaterialsTitle}" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <ListBox ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}" ItemTemplate="{StaticResource DeviceObjectTemplate}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding IsEditable}" Margin="0,0,0,8" />
                            </DockPanel>
                        </materialDesign:Card>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
